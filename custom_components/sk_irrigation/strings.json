          "sidebar_title": "Sidebar title",
          "require_admin": "Only administrators can open the panel"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "status": {
        "name": "Status",
        "state": {
          "idle": "Idle",
          "running": "Watering",
          "paused": "Paused by conditions",
          "rain_delay": "Rain delay",
          "disabled": "Disabled"
        }
      },
      "next_run": {
        "name": "Next run"
      },
      "remaining": {
        "name": "Remaining time"
      },
      "active_zones": {
        "name": "Active zones"
      },
      "current_zone": {
        "name": "Current sprinkler"
      }
    },
    "switch": {
      "system": {
        "name": "Irrigation system"
      }
    }
  },
  "services": {
    "run_program": {
      "name": "Run program",
      "description": "Queues an irrigation program now.",
      "fields": {
        "program": {
          "name": "Program",
          "description": "Program name or id."
        }
      }
    },
    "run_group": {
      "name": "Run group",
      "description": "Waters every zone of a group.",
      "fields": {
        "group": {
          "name": "Group",
          "description": "Group name or id."
        },
        "duration": {
          "name": "Minutes per zone",
          "description": "Watering time per zone."
        },
        "concurrency": {
          "name": "Simultaneous zones",
          "description": "How many zones at once (0 = all)."
        }
      }
    },
    "run_zone": {
      "name": "Run zone",
      "description": "Waters a single zone.",
      "fields": {
        "zone": {
          "name": "Zone",
          "description": "Zone name, id or entity id."
        },
        "duration": {
          "name": "Minutes",
          "description": "Watering time."
        }
      }
    },
    "stop_all": {
      "name": "Stop all",
      "description": "Stops the current run and clears the queue."
    },
    "skip": {
      "name": "Skip",
      "description": "Ends the active zone(s) and moves on.",
      "fields": {
        "zone": {
          "name": "Zone",
          "description": "Only skip this zone id."
        }
      }
    },
    "set_rain_delay": {
      "name": "Rain delay",
      "description": "Suspends scheduled programs for some hours (0 clears it).",
      "fields": {
        "hours": {
          "name": "Hours",
          "description": "Delay length."
        }
      }
    }
  }
